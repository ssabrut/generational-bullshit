    "### Cube template"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "8511312b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  Cube     :    8 verts,   12 faces\n",
      "  Subdiv×1 :   26 verts,   48 faces\n",
      "  Subdiv×2 :   98 verts,  192 faces\n",
      "  Subdiv×3 :  386 verts,  768 faces\n"
     ]
    }
